    g = GREEN if not args.no_color else ""
    y = YELLOW if not args.no_color else ""
    r = RESET if not args.no_color else ""
    b = BOLD if not args.no_color else ""

    if args.json:
        print(json.dumps({"system": sys_info, "status": "Ready", "mode": "Offline"}, indent=2))
        return

    print_banner(color=not args.no_color)
    print(f"""
╭────────────────────────────────────────────╮
│ {b}Q-FORGE — Crypto Security Analyzer{r}         │
├────────────────────────────────────────────┤
│ Platform: {sys_info['os']}
│ Kernel:   {sys_info['kernel']} ({sys_info['architecture']})
│ Mode:     Offline / Linux-Native           │
│ Scope:    Defensive Scope Guard Active     │
╰────────────────────────────────────────────╯
[{g}+{r}] Python:        {sys_info['python']}
[{g}+{r}] OpenSSL:       {sys_info['openssl']}
[{g}+{r}] Node.js:       {sys_info['node']}
[{g}+{r}] Q-FORGE:       {sys_info['qforge_version']}

Quantum Migration Readiness: {g}54%{r}
""")

def cmd_system(args):
    sys_info = get_system_info()
    net = LinuxNetworkScanner()
    ifaces = net.get_network_interfaces()
    tshark = net.get_tshark_status()

    data = {
        "system": sys_info,
        "interfaces": ifaces,
        "tshark": tshark,
        "securityTools": {
            "openssl": bool(shutil.which("openssl")),
            "ip": bool(shutil.which("ip")),
            "ss": bool(shutil.which("ss")),
            "nmap": bool(shutil.which("nmap")),
            "tshark": bool(shutil.which("tshark")),
            "tcpdump": bool(shutil.which("tcpdump"))
        }
    }

    if args.json:
        print(json.dumps(data, indent=2))
        return

    b = BOLD if not args.no_color else ""
    g = GREEN if not args.no_color else ""
    r = RESET if not args.no_color else ""

    print(f"\n{b}--- Linux System & Cryptographic Runtime ---{r}")
    print(f"Operating System: {sys_info['os']}")
    print(f"Kernel:           {sys_info['kernel']}")
    print(f"Architecture:     {sys_info['architecture']}")
    print(f"Python:           {sys_info['python']}")
    print(f"Node.js:          {sys_info['node']}")
    print(f"OpenSSL:          {sys_info['openssl']}")
    print(f"Q-FORGE Version:  {sys_info['qforge_version']}")
    print(f"\n{b}--- Linux Network Interfaces (ip addr) ---{r}")
    for iface in ifaces:
        print(f"  {iface['interface']:<10} IP: {iface['ip']:<16} CIDR: {iface['cidr']:<4} State: {iface['state']:<6} MAC: {iface['mac']}")
    print(f"\n{b}--- Packet Capture / TShark Status ---{r}")
    print(f"  Status:         {tshark['packetCaptureStatus']}")
    print(f"  TShark Binary:  {tshark['binaryPath']}")
    print(f"  Root Privilege: {'Yes' if tshark['privileges']['runningAsRoot'] else 'No (Least Privilege)'}")

def cmd_scan_source(args):
    target = args.path
    scanner = LinuxSourceScanner()
    try:
        res = scanner.scan_directory(target)
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)

    if args.json:
        print(json.dumps(res, indent=2))
        return

    if args.csv:
        writer = csv.writer(sys.stdout)
        writer.writerow(["ID", "Algorithm", "Category", "KeySize", "Location", "QuantumRisk", "PQCCandidate"])
        for f in res["findings"]:
            writer.writerow([f["id"], f["algorithm"], f["category"], f["keySize"], f["location"], f["quantumRisk"], f["pqcCandidate"]])
        return

    g = GREEN if not args.no_color else ""
    y = YELLOW if not args.no_color else ""
    r = RESET if not args.no_color else ""
    b = BOLD if not args.no_color else ""

    print_banner(color=not args.no_color)
    print(f"""
╭────────────────────────────────────────────╮
│ {b}Q-FORGE — Source Code Crypto Scan{r}          │
├────────────────────────────────────────────┤
│ Scope:    {target}
│ Files:    {res['filesScanned']}
│ Findings: {res['findingsCount']} ({res['highRiskCount']} High/Critical)
╰────────────────────────────────────────────╯
""")
    for f in res["findings"][:15]:
        risk_c = RED if f["quantumRisk"] in ("Critical", "High") else GREEN
        if args.no_color:
            risk_c = ""
        print(f"[{risk_c}{f['quantumRisk']}{r}] {f['algorithm']} ({f['keySize']}) in {f['location']}")
        print(f"    Target: {f['pqcCandidate']}")
    if len(res["findings"]) > 15:
        print(f"\n... and {len(res['findings']) - 15} more findings.")

