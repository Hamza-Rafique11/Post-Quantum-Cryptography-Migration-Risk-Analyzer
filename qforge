def cmd_benchmark(args):
    lab = LinuxBenchmarkLab()
    bms = lab.run_benchmarks(args.iterations if hasattr(args, "iterations") else 10)
    if args.json:
        print(json.dumps(bms, indent=2))
        return

    b = BOLD if not args.no_color else ""
    r = RESET if not args.no_color else ""
    print(f"\n{b}--- Empirical Cryptographic Benchmarks ---{r}")
    print(f"{'Algorithm':<16} {'KeyGen(ms)':<12} {'Op(ms)':<10} {'PubKey(B)':<10} {'Ciphertext':<10} {'Quantum Safe':<12}")
    print("-" * 74)
    for m in bms:
        qs = "YES" if m["quantumSafe"] else "NO (0 bits)"
        print(f"{m['algorithm']:<16} {m['keyGenLatencyMs']:<12} {m['operationLatencyMs']:<10} {m['publicKeySizeBytes']:<10} {m['ciphertextSizeBytes']:<10} {qs:<12}")

def main():
    parser = argparse.ArgumentParser(description="Q-FORGE Linux-Native Post-Quantum Cryptography Platform")
    parser.add_argument("--json", action="store_true", help="Output in machine-readable JSON format")
    parser.add_argument("--csv", action="store_true", help="Output in machine-readable CSV format")
    parser.add_argument("--no-color", action="store_true", help="Disable ANSI color codes")

    subparsers = parser.add_subparsers(dest="command", help="Available commands")

    # status
    p_status = subparsers.add_parser("status", help="Show system status and quantum readiness")
    p_status.set_defaults(func=cmd_status)

    # system
    p_system = subparsers.add_parser("system", help="Show Linux system, kernel, and network tools")
    p_system.set_defaults(func=cmd_system)

    # interfaces
    p_if = subparsers.add_parser("interfaces", help="List Linux network interfaces")
    p_if.set_defaults(func=cmd_interfaces)

    # scan
    p_scan = subparsers.add_parser("scan", help="Scan operations")
    scan_subs = p_scan.add_subparsers(dest="scan_type", help="Scan type")

    p_scan_source = scan_subs.add_parser("source", help="Scan source code directory")
    p_scan_source.add_argument("path", help="Directory path to scan")
    p_scan_source.add_argument("--headless", action="store_true", help="Run without UI")
    p_scan_source.set_defaults(func=cmd_scan_source)

    p_scan_cert = scan_subs.add_parser("certificate", help="Analyze X.509 certificate file")
    p_scan_cert.add_argument("path", help="Certificate PEM or CRT file path")
    p_scan_cert.set_defaults(func=cmd_scan_cert)

    p_scan_tls = scan_subs.add_parser("tls", help="Analyze endpoint TLS posture")
    p_scan_tls.add_argument("endpoint", help="Host or host:port")
    p_scan_tls.set_defaults(func=cmd_scan_tls)

    # benchmark
    p_bench = subparsers.add_parser("benchmark", help="Run empirical cryptographic benchmarks")
    p_bench.add_argument("--iterations", type=int, default=10, help="Benchmark iterations")
    p_bench.set_defaults(func=cmd_benchmark)

    args = parser.parse_args()
    if hasattr(args, "func"):
        args.func(args)
    else:
        # Default action: show status
        cmd_status(args)

if __name__ == "__main__":
    main()
