# ANSI color codes
CYAN = "\033[36m"
GREEN = "\033[32m"
YELLOW = "\033[33m"
RED = "\033[31m"
BOLD = "\033[1m"
RESET = "\033[0m"

def get_system_info():
    """Extract runtime Linux system information."""
    os_name = "Linux"
    os_release = Path("/etc/os-release")
    if os_release.exists():
        try:
            for line in os_release.read_text(encoding="utf-8").splitlines():
                if line.startswith("PRETTY_NAME="):
                    os_name = line.split("=")[1].strip('"')
                    break
        except Exception:
            pass

    kernel = platform.release()
    arch = platform.machine()
    py_ver = platform.python_version()

    # Node.js version
    node_ver = "Not Installed"
    node_bin = shutil.which("node")
    if node_bin:
        try:
            res = subprocess.run([node_bin, "-v"], capture_output=True, text=True, timeout=2)
            node_ver = res.stdout.strip()
        except Exception:
            pass

    # OpenSSL version
    openssl_ver = "Not Installed"
    openssl_bin = shutil.which("openssl")
    if openssl_bin:
        try:
            res = subprocess.run([openssl_bin, "version"], capture_output=True, text=True, timeout=2)
            openssl_ver = res.stdout.strip()
        except Exception:
            pass

    return {
        "os": os_name,
        "kernel": kernel,
        "architecture": arch,
        "python": py_ver,
        "node": node_ver,
        "openssl": openssl_ver,
        "qforge_version": "1.0.0 (Linux-Native)",
        "offline_mode": True
    }

def print_banner(color=True):
    c = CYAN if color else ""
    r = RESET if color else ""
    b = BOLD if color else ""
    print(f"""{c}╔══════════════════════════════════════════════╗
║                 {b}Q-FORGE{r}{c}                      ║
║   Post-Quantum Cryptography Risk Analyzer    ║
╚══════════════════════════════════════════════╝{r}""")

